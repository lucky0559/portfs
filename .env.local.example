# Gmail (Nodemailer) — used by the /api/contact route to send emails server-side
# 1. Enable 2-Step Verification on your Google Account
# 2. Go to Google Account → Security → App Passwords
# 3. Create an App Password for "Mail" (select "Other" if Mail isn't listed)
# 4. Copy this file to .env.local and fill in the 16-character app password

GMAIL_USER=angelorabosa5@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
